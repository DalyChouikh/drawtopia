{
  "expo": {
    "name": "DrawTopia",
    "slug": "drawtopia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drawtopia.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3D7BFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.drawtopia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "drawtopia",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7EE"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
